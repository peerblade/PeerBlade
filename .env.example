PEERBLADE_DOMAIN=my.peerblade.com
PEERBLADE_MARKETING_DOMAIN=peerblade.com
PEERBLADE_DEV_DOMAIN=dev.peerblade.com
PEERBLADE_GA_ID=G-Y0Y611BB4Q
PEERBLADE_API_HOSTNAME=peerblade-api
PEERBLADE_WEB_HOSTNAME=peerblade-web
PEERBLADE_DEV_ADMIN_USER=admin
PEERBLADE_DEV_ADMIN_PASSWORD_HASH='$2a$14$replace_with_separate_development_hash'
PEERBLADE_AUTH_PROXY_MODE=app
PEERBLADE_IMAGE_TAG=latest

POSTGRES_DB=peerblade
POSTGRES_USER=peerblade
POSTGRES_PASSWORD=replace-with-openssl-rand-hex-32
LOG_LEVEL=info
AGENT_OFFLINE_AFTER_SECONDS=90
AGENT_ENROLLMENT_TTL_MINUTES=15
AUTH_SESSION_TTL_HOURS=168
AUTH_SETUP_TOKEN_HASH=replace_with_sha256_of_a_random_one_time_token
AUTH_SETUP_TOKEN_EXPIRES_AT=replace_with_a_unix_timestamp

# Optional. Configure only on the official collector at peerblade.com.
INSTALLATION_NOTIFICATION_RESEND_API_KEY=
INSTALLATION_NOTIFICATION_FROM=PeerBlade Installations <installations@peerblade.com>
INSTALLATION_NOTIFICATION_TO=contact@peerblade.com

# Required by compose.agent.yml after the server and token are created.
PEERBLADE_SERVER_ID=00000000-0000-4000-8000-000000000000
PEERBLADE_AGENT_TOKEN=pbl_replace_with_the_token_from_control_plane
PEERBLADE_AGENT_IMAGE_TAG=latest
PEERBLADE_HEARTBEAT_INTERVAL=30s
PEERBLADE_SNAPSHOT_INTERVAL=60s
PEERBLADE_COMMAND_INTERVAL=5s
PEERBLADE_MANAGED_INTERFACE=peerblade0
PEERBLADE_MANAGED_ENDPOINT=node.example.com:51822
PEERBLADE_MANAGED_ADDRESS_CIDR=10.44.0.1/24
PEERBLADE_MANAGED_DNS=1.1.1.1,8.8.8.8
PEERBLADE_MANAGED_ALLOWED_IPS=0.0.0.0/0

# PeerBlade — control plane configuration.
# Copy to .env and fill in. bootstrap.sh generates the secrets for you.

# The domain the panel is served on. Must already resolve to this host:
# Caddy requests a TLS certificate on first start.
PEERBLADE_DOMAIN=panel.example.com

# Release to run. Omit or set to latest to follow the newest release;
# pin a version for reproducible deployments.
PEERBLADE_IMAGE_TAG=latest

# Application authentication is active from the first request. Caddyfile.basic
# remains available only as an optional compatibility layer.
PEERBLADE_AUTH_PROXY_MODE=app

# Internal hostnames on the Docker network. Change only if they collide.
PEERBLADE_API_HOSTNAME=peerblade-api
PEERBLADE_WEB_HOSTNAME=peerblade-web

# Database. The volume lives in Docker; back it up with pg_dump.
POSTGRES_DB=peerblade
POSTGRES_USER=peerblade
POSTGRES_PASSWORD=generated by bootstrap.sh

# Runtime behaviour.
LOG_LEVEL=info
AGENT_OFFLINE_AFTER_SECONDS=90
AGENT_ENROLLMENT_TTL_MINUTES=15
AUTH_SESSION_TTL_HOURS=168
AUTH_SETUP_TOKEN_HASH=generated by setup-token.sh
AUTH_SETUP_TOKEN_EXPIRES_AT=generated by setup-token.sh
